# Auto detect text files and perform LF normalization
* text=auto

# R source files
*.R text eol=lf
*.r text eol=lf
*.Rd text eol=lf
*.Rmd text eol=lf
*.Rproj text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
DESCRIPTION text eol=lf
NAMESPACE text eol=lf
.Rbuildignore text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.rds binary
*.RData binary
*.rda binary
